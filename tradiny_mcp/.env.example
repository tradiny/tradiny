# Tradiny MCP server environment. Copy to `.env` and edit.
# (tradiny_mcp/config.py loads `.env`; variables can also be set in the
# process environment, which takes precedence.)

# REQUIRED -- where the Tradiny backend and frontend are served.
# BACKEND_URL is the HTTP(S) origin of the backend; the server derives the
# WebSocket endpoint by appending /websocket/.
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

# Server binding / transport. MCP_TRANSPORT: http (default), sse, or stdio.
MCP_HOST=0.0.0.0
MCP_PORT=9010
MCP_TRANSPORT=http

# Where get_chart_image saves rendered PNGs.
OUTPUT_DIR=./output

# Timeout budgets (seconds).
WS_TIMEOUT_SECONDS=30
CHART_TIMEOUT_SECONDS=60
SCAN_TIMEOUT_SECONDS=300
# Client-side silence window (s) after the last progress line before the
# scanner is considered finished. See mcp_plan.md section 5.4.5.
SCAN_QUIESCE_SECONDS=5
